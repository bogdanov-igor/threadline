# Переменные Threadline. Реальных значений здесь нет. В Kubernetes: ConfigMap и Secret, локально: копия этого файла с именем .env.
# Пустая переменная считается незаданной. Подробно о развёртывании: README.ru.md.
# «Обязательна в образе» значит: в образе задан THREADLINE_STRICT_START=1, и без переменной сервер не запускается.

# ---- Сервер ----

# Необязательна. Адрес, который слушает сервер. В образе 0.0.0.0, локально 127.0.0.1.
# HOST=0.0.0.0
# Необязательна. Порт сервера, целое число от 0 до 65535. По умолчанию 8080.
# PORT=8080
# Необязательна. Уровень журнала: fatal, error, warn, info, debug, trace, silent. По умолчанию info.
# LOG_LEVEL=info
# Необязательна. Штатная переменная Node. В образе предел кучи под под 1 ГиБ; треть кучи — память под результаты поиска.
# Под с другой памятью: около 60% предела пода, 640 при 1 ГиБ, 1280 при 2 ГиБ. README.ru.md, «Ресурсы».
# NODE_OPTIONS=--max-old-space-size=640
# Необязательна. Сколько секунд сервер ждёт завершения работы после SIGTERM, потом выходит с кодом 1. Целое число больше нуля. По умолчанию 25.
# Держите меньше terminationGracePeriodSeconds пода.
# THREADLINE_SHUTDOWN_TIMEOUT_SECONDS=25
# Необязательна. 1 делает обязательными базу и учётные данные хранилищ. В образе уже задана: 1. Локально не задана.
# THREADLINE_STRICT_START=1
# Необязательна. Путь к файлу настроек; относительный путь считается от корня проекта. По умолчанию config/threadline.yaml.
# THREADLINE_CONFIG=config/threadline.yaml
# Необязательна. Ревизия исходников для «О Threadline», «Сервис» и /api/health. В образ её пишет аргумент сборки, задавать при запуске не нужно. Пустая: ревизии нет.
# THREADLINE_REVISION=
# Необязательна. Когда собран образ, в ISO 8601, например 2026-01-15T09:30:00Z. В образ её пишет аргумент сборки. Пустая или нечитаемая: даты нет.
# THREADLINE_BUILD_DATE=

# ---- База (PostgreSQL) ----

# Обязательна в образе, локально необязательна: без неё справочник, короткие ссылки и проекты со страниц выключены.
# Адрес вида postgres://пользователь:пароль@хост:5432/база. Символы пароля / ? # @ : % и пробел кодируются (encodeURIComponent).
# TLS: параметры адреса (?sslmode=verify-full) и NODE_EXTRA_CA_CERTS. Пароль в журнал не попадает.
# THREADLINE_DATABASE_URL=postgres://threadline:<пароль>@db.corp.example:5432/threadline

# ---- Хранилище: Loki через Grafana (loki-grafana) ----

# Обязательна, если в файле настроек есть хранилище loki-grafana без url. В config/threadline.yaml адреса нет. Адрес вида https://grafana.corp.example.
# Значение ниже только образец: чтобы посмотреть демо-среду, токен и настоящий адрес не нужны.
THREADLINE_GRAFANA_URL=https://grafana.corp.example
# Обязательна в образе, если в файле настроек есть хранилище loki-grafana; локально необязательна: без неё среды хранилища получают «не настроено».
# Токен Grafana с правом чтения источника Loki: API-ключ (Grafana 8.5) или токен сервисного аккаунта, роль Viewer. Имя переменной задаёт tokenEnv в файле настроек.
THREADLINE_GRAFANA_TOKEN=
# Необязательна. Адрес Grafana для браузера пользователя, если сервер ходит к ней по другому адресу. По умолчанию адрес выше.
# THREADLINE_GRAFANA_PUBLIC_URL=https://grafana-public.corp.example
# Необязательна. Имя источника Loki в Grafana. По умолчанию значение из файла настроек: Loki.
# THREADLINE_GRAFANA_DATASOURCE=Loki
# Необязательна. Предел одного запроса к Grafana, секунд, целое число больше нуля. По умолчанию значение из файла настроек: 30.
# THREADLINE_GRAFANA_TIMEOUT_SECONDS=30
# Необязательна. Сколько запросов к Grafana идёт одновременно, от 1 до 32. По умолчанию значение из файла настроек: 4.
# THREADLINE_GRAFANA_MAX_CONCURRENT=4

# ---- Хранилище: Loki напрямую (loki) ----

# Обязательна, если в файле настроек есть хранилище loki без url. Адрес Loki без /loki/api/v1, например http://loki:3100 или адрес за обратным прокси.
# Хранилище loki в файле должно быть одно: при нескольких адреса задаются в файле.
# THREADLINE_LOKI_URL=http://loki:3100
# Необязательна. Арендатор для заголовка X-Scope-OrgID у Loki с несколькими арендаторами; несколько через |. Без неё заголовка нет.
# THREADLINE_LOKI_TENANT=team-a
# Необязательна. Предел одного запроса к Loki, секунд, целое число больше нуля. По умолчанию значение из файла настроек: 30.
# THREADLINE_LOKI_TIMEOUT_SECONDS=30
# Необязательна. Сколько запросов к Loki идёт одновременно, от 1 до 32. По умолчанию значение из файла настроек: 4.
# THREADLINE_LOKI_MAX_CONCURRENT=4
# Необязательна: Loki без входа обходится без неё. Токен Bearer, если Loki за прокси с проверкой токена. Имя переменной задаёт tokenEnv хранилища loki.
# THREADLINE_LOKI_TOKEN=
# Необязательны, только обе сразу и без токена выше. Вход Basic: имя и пароль. Имена переменных задают usernameEnv и passwordEnv хранилища loki.
# THREADLINE_LOKI_USERNAME=
# THREADLINE_LOKI_PASSWORD=

# ---- Вход через OIDC (например, Keycloak) ----

# Подойдёт любой провайдер OIDC с discovery: Keycloak, Authentik, Okta, Microsoft Entra ID, Zitadel, Dex.
# Три переменные ниже задаются только вместе, они включают вход. Без них действует раздел auth файла настроек; в config/threadline.yaml это auth: off,
# и сервер не запускается, если не задано разрешение THREADLINE_ALLOW_NO_LOGIN ниже.
# Необязательна, только вместе с двумя следующими. Адрес сервиса для браузера, без пути. http:// только для localhost и 127.0.0.1.
# THREADLINE_PUBLIC_URL=https://threadline.corp.example
# Необязательна, только вместе с соседними. Адрес issuer провайдера, от него читается .well-known/openid-configuration. У Keycloak это адрес realm.
# THREADLINE_OIDC_ISSUER=https://sso.corp.example/realms/threadline
# Необязательна, только вместе с двумя предыдущими. Идентификатор клиента.
# THREADLINE_OIDC_CLIENT_ID=threadline
# Обязательна при включённом входе. Секрет клиента OIDC.
# THREADLINE_OIDC_CLIENT_SECRET=
# Обязательна при включённом входе. Ключ подписи сессии, не короче 32 символов: openssl rand -hex 32.
# THREADLINE_SESSION_SECRET=
# Необязательна. Поле токена со списком ролей: имя или путь через точку. По умолчанию realm_access.roles, как у Keycloak;
# у других провайдеров обычно groups или roles. Важнее поля roleClaim раздела auth файла настроек.
# THREADLINE_OIDC_ROLE_CLAIM=groups
# Необязательна. Области запроса сверх openid и profile, через пробел или запятую: groups, если провайдер кладёт группы только по ней.
# THREADLINE_OIDC_SCOPES=groups

# Только для локальной работы, в кластере не задавайте. 1 разрешает запуск без входа (auth: off): у каждого запроса права администратора, номера карт и секреты под маской.
# Без этой переменной сервер с auth: off не запускается и называет, что задать. Для демо-среды нужна так же.
# THREADLINE_ALLOW_NO_LOGIN=1

# ---- Сертификаты и прокси ----

# Необязательна. Корневой сертификат в PEM для Grafana, Loki и провайдера входа, если в файле настроек нет своего caFile. Путь к смонтированному файлу, в образе сертификатов нет.
# THREADLINE_CA_FILE=/etc/threadline/certs/root-ca.pem
# Необязательна. Корневой сертификат для TLS базы и прокси с подменой сертификата: штатная переменная Node, путь к файлу PEM.
# NODE_EXTRA_CA_CERTS=/etc/threadline/certs/root-ca.pem
# Необязательны. Корпоративный прокси, если Grafana, Loki, провайдер входа или Telegram доступны только через него. Адрес вида http://proxy.corp.example:3128.
# HTTPS_PROXY=http://proxy.corp.example:3128
# HTTP_PROXY=http://proxy.corp.example:3128
# Необязательна. Адреса без прокси, через запятую.
# NO_PROXY=localhost,127.0.0.1

# ---- Telegram ----

# Необязательны, только обе сразу. Нужен выход на api.telegram.org, напрямую или через HTTPS_PROXY. Без них сервис работает полностью.
# Токен бота: не показывается и не пишется в журнал.
# THREADLINE_TELEGRAM_BOT_TOKEN=
# Идентификатор чата, куда бот пишет.
# THREADLINE_TELEGRAM_CHAT_ID=

# ---- Только для docker compose на этой машине ----

# Только для docker compose. Пароль контейнера базы, совпадает с паролем в THREADLINE_DATABASE_URL: openssl rand -hex 24. Символы # и $ не используйте.
# Пароль фиксируется при первом создании тома: после смены том нужно пересоздать.
# THREADLINE_DB_PASSWORD=
# Только для docker compose. Порт базы на этой машине, по умолчанию 5432.
# THREADLINE_DB_PORT=5432
# Только для docker compose, локальный Keycloak (профиль keycloak): порт на этой машине и пароль администратора.
# THREADLINE_KEYCLOAK_PORT=8180
# THREADLINE_KEYCLOAK_ADMIN_PASSWORD=

# ---- Только для тестов ----

# Только для тестов. Каталог собранного интерфейса: сквозные тесты собирают его отдельно.
# THREADLINE_WEB_DIST=apps/web/dist-e2e
# Только для тестов. 1: «Неизвестное» пишется и для демо-среды.
# THREADLINE_CATALOG_DEMO_INBOX=1
# Только для тестов. Адрес своего PostgreSQL для vitest и Playwright.
# THREADLINE_TEST_DATABASE_URL=
# THREADLINE_E2E_DATABASE_URL=

# ---- Локальный режим (pnpm local) ----

# Необязательна, только для pnpm local. Папка данных вместо ~/.threadline: настройка, база PGlite и storages.json с токенами хранилищ.
# Команда этот файл не читает: переменную задают в окружении, флаг --data важнее неё.
# THREADLINE_DATA=/путь/к/папке
