{
  "name": "threadline",
  "version": "0.2.1",
  "description": "Request-tracing log viewer: enter any identifier and see each request as a flow of steps across services, stitched from Loki logs, with personal data masked on the server",
  "keywords": [
    "logs",
    "log-viewer",
    "loki",
    "grafana",
    "tracing",
    "request-tracing",
    "correlation-id",
    "observability",
    "masking",
    "fastify",
    "react"
  ],
  "homepage": "https://github.com/bogdanov-igor/threadline#readme",
  "bugs": {
    "url": "https://github.com/bogdanov-igor/threadline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogdanov-igor/threadline.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Igor Bogdanov",
  "contributors": [
    "Aleksandr Ivanov"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @threadline/server --filter @threadline/web dev",
    "build": "pnpm --filter @threadline/web build",
    "start": "pnpm --filter @threadline/server start",
    "local": "node -e \"process.exit(require('node:fs').existsSync('apps/web/dist/index.html') ? 0 : 1)\" || pnpm build && node --disable-warning=ExperimentalWarning apps/server/src/cli/local.ts",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @threadline/web test:e2e",
    "test:e2e:pg": "pnpm --filter @threadline/web test:e2e:pg",
    "lint": "eslint apps packages eslint.config.js",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "threadline:check": "pnpm -C apps/server check",
    "threadline:catalog": "pnpm -C apps/server catalog",
    "threadline:sample": "pnpm -C apps/server sample",
    "threadline:migrate": "pnpm -C apps/server migrate",
    "threadline:demo-logs": "pnpm -C apps/server demo-logs",
    "docs:shots": "node dev/docs-shots/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
